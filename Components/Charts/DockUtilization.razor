@using MyProject.Services
@using Radzen
@using Radzen.Blazor
@inject VehicleMetricsService MetricsService
@implements IDisposable

<div class="chart-card">
    <div class="chart-header">
        <h3>DOCK UTILIZATION</h3>
    </div>
    <div class="donut-container" style="position: relative;">
        <RadzenChart>
            <RadzenDonutSeries Data="@MetricsService.DockUtilization" CategoryProperty="Category" ValueProperty="Value" 
                               Fills="@(new [] { "#2563eb", "#16a34a", "#eab308", "#dc2626" })">
                <ChildContent>
                    <RadzenSeriesDataLabels Visible="true" />
                </ChildContent>
            </RadzenDonutSeries>
            <RadzenLegend Position="LegendPosition.Right" />
        </RadzenChart>
        <div class="donut-center-text" style="position: absolute; top: 50%; left: 35%; transform: translate(-50%, -50%); text-align: center; pointer-events: none;">
            <div style="font-size: 12px; color: #cbd5e1; font-weight: bold;">TOTAL<br/>DOCKS</div>
            <div style="font-size: 24px; color: white; font-weight: bold;">12</div>
        </div>
    </div>
    <div style="text-align: center; color: #eab308; font-weight: bold; margin-top: -10px;">
        Utilization : 75%
    </div>
</div>

<style>
    .chart-card {
        background-color: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }
    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }
    .chart-header h3 {
        color: white;
        font-size: 14px;
        font-weight: 700;
        margin: 0;
        letter-spacing: 0.5px;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        MetricsService.OnDataUpdated += UpdateUI;
    }

    private void UpdateUI()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        MetricsService.OnDataUpdated -= UpdateUI;
    }
}
